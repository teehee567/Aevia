	(text "Place 100nF/10uF/47uF at the module supply pins. J800 is isolated from STM TX by R805. Keep the antenna keep-out clear."
		(exclude_from_sim no)
		(at 36 174 0)
		(effects
			(font
				(size 1.1 1.1)
			)
		)
		(uuid "3e25ff7d-f104-45c5-908d-1b26bb501d4e")
	)
	(text "ESP_EN and ESP_BOOT must be driven open-drain by STM32 firmware; series resistors preserve reset straps."
		(exclude_from_sim no)
		(at 35 31 0)
		(effects
			(font
				(size 1.1 1.1)
			)
		)
		(uuid "e7c19c2e-1802-46c8-9884-dff1f42c3620")
	)
	(text "J800.1 is level-reference sensing only: do not use the programmer to power the radio rail. R807 limits accidental backfeed."
		(exclude_from_sim no)
		(at 36 188 0)
		(effects
			(font
				(size 1.05 1.05)
			)
		)
		(uuid "fa16be51-3930-4a16-9dfb-f62662d3695f")
	)
	(text "POWER SEQUENCE: set ESP_UART_TX/CTS, ESP_EN and ESP_BOOT low or Hi-Z before RADIO_EN=0; do not drive them until +3V3_RADIO_SW is valid."
		(exclude_from_sim no)
		(at 36 181 0)
		(effects
			(font
				(size 1.05 1.05)
			)
		)
