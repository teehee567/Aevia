	(text "UM980 supply requires >=30uF local bulk plus 100nF. ANT_BIAS is protected +5V_AUX; assert AUX5_EN for the active antenna."
		(exclude_from_sim no)
		(at 34 180 0.0000)
		(effects
			(font
				(size 1.1 1.1)
			)
		)
		(uuid "bb408ffe-4168-4d93-9e5c-42e811c5ae20")
	)
	(text "POWER SEQUENCE: set GNSS_UART_TX, GNSS_EVENT and GNSS_RESET_N low or Hi-Z before GNSS_EN=0; do not drive until +3V3_GNSS_CLEAN is valid. UM980 requires VCC <0.4 V for >500 ms before re-enable; apply the same off-time if V_BCKP is cycled."
		(exclude_from_sim no)
		(at 34 187 0.0000)
