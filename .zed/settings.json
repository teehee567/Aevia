{
    "lsp": {
        "rust-analyzer": {
            "initialization_options": {
                "cargo": {
                    "target": "x86_64-pc-windows-msvc",
                    "allTargets": false,
                    "buildScripts": {
                        "overrideCommand": [
                            "cargo", "check", "--workspace", "--lib", "--message-format=json"
                        ]
                    }
                },
                "check": {
                    "extraArgs": ["--lib"]
                }
            }
        }
    }
}
